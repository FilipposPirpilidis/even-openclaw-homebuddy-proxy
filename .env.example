# Choose how ordinary requests reach OpenClaw: telegram or direct.
OPENCLAW_TRANSPORT=telegram

# Direct mode settings. The Gateway Chat Completions endpoint must be enabled.
OPENCLAW_BASE_URL=http://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT=openclaw/default
OPENCLAW_SESSION_USER=even-homebuddy-glasses
OPENCLAW_SESSION_STATE_PATH=/data/openclaw-session.json
OPENCLAW_TIMEOUT_SECONDS=240

# Optional last-known-location context for direct mode. The client must still
# explicitly share a location before anything is stored or sent to OpenClaw.
LOCATION_CONTEXT_ENABLED=false
LOCATION_STATE_PATH=/data/client-location.json
LOCATION_MARKDOWN_PATH=/openclaw-location/latest.md
LOCATION_MAX_AGE_SECONDS=86400
LOCATION_DISPLAY_TIMEZONE=Europe/Athens
LOCATION_ENRICHMENT_ENABLED=true
LOCATION_ENRICHMENT_TIMEOUT_SECONDS=20
LOCATION_ENRICHMENT_CACHE_SECONDS=900
LOCATION_NEARBY_RADIUS_METERS=250
LOCATION_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
LOCATION_OVERPASS_URL=https://overpass-api.de/api/interpreter
LOCATION_OSM_USER_AGENT="HomeBuddy-OpenClaw/1.0 (+https://github.com/FilipposPirpilidis/even-openclaw-homebuddy-proxy)"
LOCATION_OSM_LANGUAGE=el,en

# Host directory published into OpenClaw's workspace. On the Raspberry this is:
OPENCLAW_LOCATION_DIR=/home/pi/.openclaw/workspace/location
OPENCLAW_WORKSPACE_GID=1000

# Telegram mode credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The login helper stores the Telethon session at this path.
TELEGRAM_SESSION_PATH=/data/telegram-user

# Used only by the login helper to resolve the bot ID.
TELEGRAM_TARGET=YourOpenClawBotUsername

# Set this after running the login helper.
TELEGRAM_TARGET_ID=0

# Generate one with: openssl rand -hex 32
PROXY_BEARER_TOKEN=replace-me

TELEGRAM_RESPONSE_TIMEOUT_SECONDS=240
TELEGRAM_SETTLE_SECONDS=2.5
MAX_REQUEST_CHARS=12000
LOG_LEVEL=INFO

# Optional Home Assistant integration. Leave the token empty and do not create
# config/offline_commands.json if you do not want local command routing.
HA_OFFLINE_CONFIG_PATH=/config/offline_commands.json
HOME_ASSISTANT_TOKEN=

# Docker port binding. Use a LAN address to avoid exposing the service on every
# host interface, for example 192.168.1.50.
PROXY_BIND_ADDRESS=127.0.0.1
PROXY_PORT=18989

