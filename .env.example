# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The login helper stores the Telethon session at this path.
TELEGRAM_SESSION_PATH=/data/telegram-user

# Used only by the login helper to resolve the bot ID.
TELEGRAM_TARGET=YourOpenClawBotUsername

# Set this after running the login helper.
TELEGRAM_TARGET_ID=0

# Generate one with: openssl rand -hex 32
PROXY_BEARER_TOKEN=replace-me

TELEGRAM_RESPONSE_TIMEOUT_SECONDS=240
TELEGRAM_SETTLE_SECONDS=2.5
MAX_REQUEST_CHARS=12000
LOG_LEVEL=INFO

# Optional Home Assistant integration. Leave the token empty and do not create
# config/offline_commands.json if you do not want local command routing.
HA_OFFLINE_CONFIG_PATH=/config/offline_commands.json
HOME_ASSISTANT_TOKEN=

# Docker port binding. Use a LAN address to avoid exposing the service on every
# host interface, for example 192.168.1.50.
PROXY_BIND_ADDRESS=127.0.0.1
PROXY_PORT=18989

